# Gemini (preferred for this assignment). Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional OpenAI fallback if GEMINI_API_KEY is unset
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# auto | gemini | openai | stub
# auto: Gemini if GEMINI_API_KEY, else OpenAI if OPENAI_API_KEY, else stub
LLM_MODE=auto

# SQLite database path (relative to the backend working directory)
DATABASE_URL=sqlite:///./data/app.db

# Uploaded files
UPLOAD_DIR=./data/uploads

# Optional: full path to the tesseract executable on Windows
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Comma-separated browser origins, or * for a public demo
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Railway sets PORT, RAILWAY_ENVIRONMENT, and RAILWAY_PUBLIC_DOMAIN.
# On Railway, SQLite/uploads default to /data and CORS is * unless you override them.
# Add GEMINI_API_KEY in the Railway Variables UI (do not commit it).

# Fallback password for clinicians and for patients created by document linking
# (no stored password yet). New patient IDs set their own password on first login.
DEMO_PATIENT_PASSWORD=demo
